{
  "version": 2,
  "buildCommand": "cd backend && pip install -r requirements.txt",
  "outputDirectory": "backend",
  "installCommand": "cd backend && pip install -r requirements.txt",
  "builds": [
    {
      "src": "backend/api/simple.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/api/simple.py"
    }
  ]
}
