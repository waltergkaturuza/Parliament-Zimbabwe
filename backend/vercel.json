{
  "version": 2,
  "builds": [
    {
      "src": "api/simple.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/migrate.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/test.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/test",
      "dest": "api/test.py"
    },
    {
      "src": "/api/migrate",
      "dest": "api/migrate.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/simple.py"
    }
  ],
  "installCommand": "",
  "buildCommand": "",
  "framework": null
}
