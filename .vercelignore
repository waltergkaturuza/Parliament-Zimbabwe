# Vercel ignore file - exclude ALL unnecessary files to minimize function size

# CRITICAL: Exclude frontend to prevent Node.js build detection
fuel-coupon-frontend/
package.json
package-lock.json
node_modules/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/

# Development files
.env*
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE files
.vscode/
.idea/
*.sublime-*

# Git
.git/
.gitignore
.gitattributes

# Documentation and non-essential files
*.md
*.txt
*.log
*.zip
docs/
documentation/
screenshots/
images/
static/images/
static/img/

# Test files
tests/
test_*.py
*_test.py
*_tests.py
conftest.py
pytest.ini
tox.ini
.coverage
htmlcov/

# Media uploads
media/

# Development dependencies
requirements-*.txt
!requirements.txt

# Azure deployment files (not needed for Vercel)
azure_*
AZURE_*
*.bat
*.ps1

# Large packages and apps not needed for basic API
**/migrations/*.py
!**/migrations/__init__.py
!**/migrations/0001_initial.py

# Database files
*.sqlite3
*.db

# Logs and temporary files
logs/
tmp/
temp/
*.tmp

# Large Python packages commonly causing size issues
**/site-packages/
**/dist-packages/

# Frontend related files (deploying backend only)
*.js
*.jsx
*.ts
*.tsx
*.html
*.css
*.scss
frontend/
staticfiles/
static/
public/
dist/
build/
