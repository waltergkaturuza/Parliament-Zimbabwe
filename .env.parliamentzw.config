# Parliament of Zimbabwe - Dynamics 365 Integration Configuration
# Based on your Microsoft Cloud account setup

# =============================================================================
# YOUR SPECIFIC DYNAMICS 365 CONFIGURATION
# =============================================================================

# Azure AD Configuration (from your signup email)
DYNAMICS_TENANT_ID=086c4475-d0ef-4d2b-871c-4e078a083db5
DYNAMICS_ADMIN_USER=admin@parliamentzw.onmicrosoft.com
# Note: Admin password provided separately for security

# Business Central URLs (based on your tenant ID)
DYNAMICS_BC_ADMIN_CENTER=https://businesscentral.dynamics.com/086c4475-d0ef-4d2b-871c-4e078a083db5/admin
DYNAMICS_M365_ADMIN_CENTER=https://admin.microsoft.com/Adminportal/Home

# Environment-specific URLs (you'll need to set these after environment creation)
# Sandbox Environment:
DYNAMICS_BC_URL_SANDBOX=https://api.businesscentral.dynamics.com/v2.0/086c4475-d0ef-4d2b-871c-4e078a083db5/sandbox/ODataV4/
# Production Environment:
DYNAMICS_BC_URL_PRODUCTION=https://api.businesscentral.dynamics.com/v2.0/086c4475-d0ef-4d2b-871c-4e078a083db5/production/ODataV4/

# =============================================================================
# NEXT STEPS REQUIRED
# =============================================================================

# 1. CREATE AZURE AD APP REGISTRATION
#    - You'll need to create this to get CLIENT_ID and CLIENT_SECRET
#    - Use the Azure Portal: https://portal.azure.com
#    - Login with: admin@parliamentzw.onmicrosoft.com

# 2. SET UP BUSINESS CENTRAL ENVIRONMENT
#    - Access: https://businesscentral.dynamics.com/086c4475-d0ef-4d2b-871c-4e078a083db5/admin
#    - Create Sandbox environment first for testing
#    - Note the environment name and company ID

# 3. CONFIGURE INTEGRATION APP
#    - Company ID will be available after BC setup
#    - Client ID and Secret from Azure AD app registration

# =============================================================================
# INTEGRATION CONFIGURATION TEMPLATE
# =============================================================================

# These values will be populated once you complete the setup steps:
DYNAMICS_CLIENT_ID=to-be-created-in-azure-ad
DYNAMICS_CLIENT_SECRET=to-be-created-in-azure-ad
DYNAMICS_ENVIRONMENT_NAME=sandbox  # or production
DYNAMICS_COMPANY_ID=to-be-obtained-from-bc

# Integration Settings
DYNAMICS_SYNC_ENABLED=True
DYNAMICS_BATCH_SIZE=50
DYNAMICS_RETRY_ATTEMPTS=3
