# Microsoft Dynamics 365 Business Central Integration Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DYNAMICS 365 BUSINESS CENTRAL CONFIGURATION
# =============================================================================

# Azure AD Configuration
DYNAMICS_TENANT_ID=your-tenant-id-here
DYNAMICS_CLIENT_ID=your-client-id-here
DYNAMICS_CLIENT_SECRET=your-client-secret-here

# Business Central Environment
DYNAMICS_BC_URL=https://api.businesscentral.dynamics.com/v2.0/your-tenant-id/your-environment/ODataV4/
DYNAMICS_ENVIRONMENT_NAME=your-environment-name
DYNAMICS_COMPANY_ID=your-company-id-here

# Integration Settings
DYNAMICS_SYNC_ENABLED=True
DYNAMICS_BATCH_SIZE=100
DYNAMICS_RETRY_ATTEMPTS=3

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# For Sandbox Environment:
# DYNAMICS_BC_URL=https://api.businesscentral.dynamics.com/v2.0/12345678-1234-1234-1234-123456789012/sandbox/ODataV4/
# DYNAMICS_ENVIRONMENT_NAME=sandbox

# For Production Environment:
# DYNAMICS_BC_URL=https://api.businesscentral.dynamics.com/v2.0/12345678-1234-1234-1234-123456789012/production/ODataV4/
# DYNAMICS_ENVIRONMENT_NAME=production

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Azure AD App Registration:
#    - Go to Azure Portal > Azure Active Directory > App registrations
#    - Create new registration for "Fuel Coupon System BC Integration"
#    - Note the Application (client) ID and Directory (tenant) ID
#    - Create a client secret under "Certificates & secrets"
#    - Add API permissions for Dynamics 365 Business Central

# 2. Business Central Setup:
#    - Enable API services in Business Central
#    - Configure web services for required entities
#    - Set up appropriate user permissions

# 3. Network Configuration:
#    - Ensure outbound HTTPS access to api.businesscentral.dynamics.com
#    - Configure any required firewall rules

# =============================================================================
# SECURITY NOTES
# =============================================================================

# IMPORTANT: Never commit this file with real values to version control!
# Keep client secrets secure and rotate them regularly
# Use Azure Key Vault for production deployments
# Monitor API usage and rate limits
