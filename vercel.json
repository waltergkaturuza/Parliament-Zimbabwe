{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python@4.0.0",
      "config": {
        "excludeFiles": [
          "**/.git/**",
          "**/node_modules/**",
          "**/__pycache__/**",
          "**/migrations/**",
          "**/static/**",
          "**/media/**",
          "**/*.md",
          "**/*.txt",
          "**/*.log",
          "**/tests/**",
          "**/fuel-coupon-frontend/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings.vercel"
  }
}
