{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python@4.0.0",
      "config": {
        "excludeFiles": [
          "fuel-coupon-frontend/**",
          "node_modules/**",
          "package.json",
          "package-lock.json",
          "**/.git/**",
          "**/__pycache__/**",
          "**/migrations/**",
          "**/static/**",
          "**/media/**",
          "**/*.md",
          "**/*.txt",
          "**/*.log",
          "**/tests/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings.vercel"
  },
  "framework": null,
  "installCommand": "pip install -r requirements.txt"
}
